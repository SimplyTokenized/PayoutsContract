{
  "name": "payouts-contract",
  "version": "2.0.0",
  "description": "PayoutsContract - one upgradeable payout contract per tenant, paying a list of recipients per payout run by claim or by transfer",
  "license": "MIT",
  "author": "SimplyTokenized",
  "homepage": "https://github.com/SimplyTokenized/PayoutsContract#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimplyTokenized/PayoutsContract.git"
  },
  "bugs": {
    "url": "https://github.com/SimplyTokenized/PayoutsContract/issues"
  },
  "scripts": {
    "setup": "forge install OpenZeppelin/openzeppelin-contracts-upgradeable OpenZeppelin/openzeppelin-foundry-upgrades OpenZeppelin/openzeppelin-contracts",
    "build": "forge build",
    "build:sizes": "forge build --sizes",
    "test": "forge clean && forge build && forge test",
    "test:quick": "FOUNDRY_PROFILE=lite forge clean && FOUNDRY_PROFILE=lite forge build && FOUNDRY_PROFILE=lite forge test",
    "test:ci": "FOUNDRY_PROFILE=ci forge clean && FOUNDRY_PROFILE=ci forge build && FOUNDRY_PROFILE=ci forge test",
    "test:invariant": "forge clean && forge build && forge test --match-contract Invariant -vvv",
    "test:verbose": "forge clean && forge build && forge test -vvv",
    "test:gas": "forge clean && forge build && forge test --gas-report",
    "coverage": "forge clean && forge coverage --no-match-coverage '(test|script)' --report summary",
    "coverage:lcov": "forge clean && forge coverage --no-match-coverage '(test|script)' --report lcov",
    "format": "forge fmt",
    "format:check": "forge fmt --check",
    "lint": "forge lint",
    "slither": "slither . --config-file slither.config.json",
    "deploy:testnet": "forge script script/DeployPayouts.s.sol:DeployPayouts --private-key $DEPLOYER_KEY --broadcast --verify --rpc-url $TESTNET_RPC --etherscan-api-key $ETHERSCAN_API_KEY --sender $DEPLOYER",
    "deploy:fuji": "forge script script/DeployPayouts.s.sol:DeployPayouts --private-key $DEPLOYER_KEY --broadcast --verify --rpc-url $AVALANCHE_FUJI_RPC --etherscan-api-key $ETHERSCAN_API_KEY --verifier-url $AVALANCHE_FUJI_VERIFIER_URL --sender $DEPLOYER",
    "deploy:sepolia": "forge script script/DeployPayouts.s.sol:DeployPayouts --private-key $DEPLOYER_KEY --broadcast --verify --rpc-url $ETH_SEPOLIA_RPC --etherscan-api-key $ETHERSCAN_API_KEY --sender $DEPLOYER",
    "deploy:local": "forge script script/DeployPayouts.s.sol:DeployPayouts --private-key 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80 --broadcast --rpc-url http://localhost:8545 --sender 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266",
    "anvil": "anvil",
    "anvil:fork": "anvil --fork-url $MAINNET_RPC",
    "clean": "forge clean",
    "update:deps": "forge update",
    "docgen": "forge doc --build --out docs",
    "docgen:serve": "forge doc --build --serve --open --out docs"
  },
  "keywords": [
    "solidity",
    "payouts",
    "distribution",
    "dividends",
    "claim",
    "erc20",
    "erc2771",
    "upgradeable",
    "blockchain",
    "ethereum",
    "avalanche",
    "foundry",
    "tokenization",
    "security-token"
  ],
  "devDependencies": {
    "@types/node": "^20.0.0"
  }
}
